    "\n",
    "        c_l=cl/max(ct,1); c_a=100*cc/max(ct,1); rnd_losses.append(c_l); rnd_correct+=cc; rnd_total+=ct\n",
    "        history[f'c{cid}_loss'].append(round(c_l,4))\n",
    "        history[f'c{cid}_acc'].append(round(c_a,2))\n",
